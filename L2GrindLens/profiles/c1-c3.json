    "0x1D": "SunSet",
    "0x25": "ActionFailed",
    "0x27": "InventoryUpdate",
    "0x28": "TeleportToLocation",
    "0x29": "TargetSelected",
    "0x2A": "TargetUnselected",
    "0x2B": "AutoAttackStart",
    "0x2C": "AutoAttackStop",
