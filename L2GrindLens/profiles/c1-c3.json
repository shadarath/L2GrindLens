{
  // Chronicle 1 (Harbingers of War) do Chronicle 3 (Rise of Darkness).
  // Klucz XOR 8 bajtów, po każdym pakiecie key[0..3] += długość ciała.
  // Jeśli pakiet z kluczem ma postać [0x00][0x01][8 bajtów], sniffer sam wykryje offset 2.
  // Opcody poniżej to wspólny trzon C1-Interlude. Zweryfikuj je ze źródłami emulatora,
  // na którym stoi serwer (np. github.com/amelkor/l2jc1), i uzupełnij.
  "name": "c1-c3",
  "description": "Chronicle 1 - Chronicle 3",
  "protocolVersionOpcode": 0,
  "protocolVersionRange": [400, 656],
  "keyPacketOpcode": 0,
  "keyOffset": 1,
  "keyLength": 8,
  "staticKeyHex": "",
  "keyUpdateIndex": 0,
  "systemMessageOpcode": 100, // 0x64
  "systemMessageParamTypes": {
    "0": "S",   // tekst
    "1": "D",   // liczba
    "2": "D",   // id NPC (+1000000)
    "3": "D",   // id przedmiotu
    "4": "DD",  // id umiejętności, poziom
    "5": "D",   // id zamku
    "7": "DDD"  // strefa: x, y, z
  },
  "serverOpcodes": {
    "0x00": "KeyPacket",
    "0x01": "MoveToLocation",
    "0x02": "NpcSay",
    "0x03": "CharInfo",
    "0x04": "UserInfo",
    "0x05": "Attack",
    "0x06": "Die",
    "0x07": "Revive",
    "0x0B": "SpawnItem",
    "0x0C": "DropItem",
    "0x0D": "GetItem",
    "0x0E": "StatusUpdate",
    "0x0F": "NpcHtmlMessage",
    "0x12": "DeleteObject",
    "0x13": "CharSelectInfo",
    "0x14": "AuthLoginFail",
    "0x15": "CharSelected",
    "0x16": "NpcInfo",
    "0x1B": "ItemList",
